# --- model artefacts ---
# Everything under models/ is tracked: vision runtime exports, advisory
# tokenizer and manifests, configs, hash manifests and training checkpoints.
# Only the 2.1 GB advisory PTE stays local because it exceeds GitHub's
# per-file limit; publish it via an external host instead.
*.pte
runs/

# --- logs / scratch ---
*.log
*.db
*.db-wal
*.db-shm
*.sqlite
.cache/
scratch/

# --- external repos / vendor ---
third_party/

# --- secrets ---
.env
*.token

# --- personal media files ---
*.mkv
*.mp4
*.avi

# --- runtime state ---
# The audit database and its external anchor are rewritten by the station
# on every append; they are machine state, not repository content.
veriqc_audit.head.json
/artifacts/
/reports/audit_export.csv
